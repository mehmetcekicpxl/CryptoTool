@{
    ViewData["Title"] = "Key Generator";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-key-fill text-warning me-2"></i>Cryptographic Key Generator</h2>
            <p class="text-muted mb-0">Genereer veilige sleutels voor AES en RSA encryptie.</p>
        </div>
        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#keyInfoModal">
            <i class="bi bi-book"></i> Over Key Sizes
        </button>
    </div>

    <div class="card mb-5 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-shield-lock-fill me-2"></i>AES Sleutel Generatie (Symmetrisch)</h5>
        </div>
        <div class="card-body">
            <p class="card-text text-muted">Gebruik dit voor snelle encryptie van data en bestanden.</p>

            <form asp-action="GenerateAes" method="post" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Sleutelgrootte <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" title="Hoe groter de sleutel, hoe moeilijker te kraken. 256-bit is de militaire standaard."></i></label>
                </div>
                <div class="col-auto">
                    <select name="keySize" class="form-select">
                        <option value="128">128 bits</option>
                        <option value="192">192 bits</option>
                        <option value="256" selected>256 bits (Aanbevolen)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-loading">
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                        Genereer Nieuwe Sleutel
                    </button>
                </div>
            </form>

            @if (ViewBag.AesKeyBase64 != null)
            {
                <div class="alert alert-light border border-success mt-4">
                    <h6 class="alert-heading text-success"><i class="bi bi-check-circle-fill me-1"></i>Sleutel Succesvol Gegenereerd!</h6>
                    <hr>
                    <div class="mb-3">
                        <label class="fw-bold text-secondary">Key (Base64):</label>
                        <input type="text" class="form-control font-monospace" value="@ViewBag.AesKeyBase64" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold text-secondary">IV (Base64):</label>
                        <input type="text" class="form-control font-monospace" value="@ViewBag.AesIVBase64" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold text-secondary">Key (Hex):</label>
                        <input type="text" class="form-control font-monospace text-muted" value="@ViewBag.AesKeyHex" readonly>
                    </div>
                    <form asp-action="DownloadAesKey" method="post" class="mt-3">
                        <input type="hidden" name="keyBase64" value="@ViewBag.AesKeyBase64" />
                        <input type="hidden" name="ivBase64" value="@ViewBag.AesIVBase64" />
                        <button type="submit" class="btn btn-success"><i class="bi bi-download me-1"></i> Download Key & IV (.txt)</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-warning">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-key me-2"></i>RSA Sleutelpaar Generatie (Asymmetrisch)</h5>
        </div>
        <div class="card-body">
            <p class="card-text text-muted">Gebruik dit voor het veilig uitwisselen van sleutels of digitale handtekeningen.</p>

            <form asp-action="GenerateRsa" method="post" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Sleutelgrootte <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" title="RSA sleutels moeten veel groter zijn dan AES sleutels voor dezelfde veiligheid."></i></label>
                </div>
                <div class="col-auto">
                    <select name="keySize" class="form-select">
                        <option value="1024">1024 bits (Onveilig)</option>
                        <option value="2048" selected>2048 bits (Standaard)</option>
                        <option value="4096">4096 bits (Hoogste Veiligheid)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark btn-loading">
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                        Genereer RSA Paar
                    </button>
                </div>
            </form>

            @if (ViewBag.RsaPublicKey != null)
            {
                <div class="mt-4 alert alert-light border border-warning">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="fw-bold text-success mb-2">Public Key (Om te delen):</label>
                            <textarea class="form-control font-monospace mb-2" rows="6" readonly style="font-size: 0.8rem;">@ViewBag.RsaPublicKey</textarea>
                            <form asp-action="DownloadRsaPublicKey" method="post">
                                <input type="hidden" name="publicKey" value="@ViewBag.RsaPublicKey" />
                                <button type="submit" class="btn btn-outline-success btn-sm w-100"><i class="bi bi-download"></i> Download Public Key (.pem)</button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold text-danger mb-2">Private Key (GEHEIM HOUDEN!):</label>
                            <textarea class="form-control font-monospace mb-2" rows="6" readonly style="font-size: 0.8rem;">@ViewBag.RsaPrivateKey</textarea>
                            <form asp-action="DownloadRsaPrivateKey" method="post">
                                <input type="hidden" name="privateKey" value="@ViewBag.RsaPrivateKey" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-download"></i> Download Private Key (.pem)</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="keyInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-book text-info me-2"></i>Over Sleutelgroottes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>De grootte van een sleutel bepaalt hoe moeilijk het is om deze via 'brute force' te raden.</p>
                <ul>
                    <li><strong>AES (Symmetrisch):</strong> Een sleutel van 256 bits wordt beschouwd als onbreekbaar met de huidige technologie en wordt gebruikt door overheden.</li>
                    <li><strong>RSA (Asymmetrisch):</strong> Omdat RSA op wiskundige eigenschappen leunt, moeten de sleutels veel groter zijn. 2048 bits is het minimum voor modern gebruik.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<hr class="my-5" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-secondary"><i class="bi bi-hdd-network me-2"></i>Key Management (Local Storage)</h3>
    <span class="badge bg-danger fs-6">Unencrypted</span>
</div>

<div class="alert alert-warning shadow-sm">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Let op:</strong> Deze versie slaat sleutels onversleuteld op in de browser (`localStorage`).
</div>

<div class="row g-4 mt-2 mb-5">
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-dark">
            <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-save me-2"></i>Opslaan & Roteren</div>
            <div class="card-body d-flex flex-column justify-content-center">
                <button class="btn btn-primary w-100 mb-3" onclick="keyManager.saveKeys(false)">Huidige Keys Opslaan</button>
                <button class="btn btn-warning w-100" onclick="keyManager.saveKeys(true)">Rotate Key (Toevoegen als nieuw)</button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-info">
            <div class="card-header bg-info text-white fw-bold"><i class="bi bi-arrow-clockwise me-2"></i>Inladen & Wissen</div>
            <div class="card-body d-flex flex-column justify-content-center">
                <button class="btn btn-info text-white w-100 mb-3" onclick="keyManager.loadLatestKeys()">Laad Laatste Keys (Console)</button>
                <button class="btn btn-outline-danger w-100" onclick="keyManager.clearVault()">Wis Lokale Opslag</button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-secondary">
            <div class="card-header bg-secondary text-white fw-bold"><i class="bi bi-file-earmark-arrow-up me-2"></i>Import / Export</div>
            <div class="card-body d-flex flex-column justify-content-center">
                <button class="btn btn-dark w-100 mb-3" onclick="keyManager.exportVault()">Exporteer Opslag (.json)</button>
                <div class="input-group">
                    <input type="file" id="importFile" class="form-control" accept=".json">
                    <button class="btn btn-secondary" onclick="keyManager.importVault()">Import</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function(e) {
                if(this.checkValidity()) {
                    let btn = this.querySelector('.btn-loading');
                    if(btn) {
                        btn.querySelector('.spinner-border').classList.remove('d-none');
                        btn.disabled = true;
                    }
                }
            });
        });
        const keyManager = {
            storageKey: 'cryptoTool_unencrypted_keys',

            saveKeys: function(isRotation) {
                // Grabs the generated keys directly from the server-side ViewBag using Razor syntax
                // This prevents us from having to rely on specific HTML input IDs
                const aesKey = '@ViewBag.AesKeyBase64';
                const aesIv = '@ViewBag.AesIVBase64';

                // Uses Html.Raw and escaping to safely inject multiline RSA PEM strings
                const rsaPub = `@Html.Raw(ViewBag.RsaPublicKey?.Replace("`", "\\`"))`;
                const rsaPriv = `@Html.Raw(ViewBag.RsaPrivateKey?.Replace("`", "\\`"))`;

                if (!aesKey && !rsaPub) {
                    alert("Er zijn geen gegenereerde sleutels op deze pagina om op te slaan! Genereer eerst een AES of RSA sleutel.");
                    return;
                }

                // Creates the data object to store
                const newEntry = {
                    timestamp: new Date().toLocaleString(),
                    aesKey: aesKey,
                    aesIv: aesIv,
                    rsaPublicKey: rsaPub,
                    rsaPrivateKey: rsaPriv
                };

                // Retrieves existing history or starts a new array
                let history = JSON.parse(localStorage.getItem(this.storageKey) || "[]");

                if (isRotation) {
                    history.push(newEntry); // Key rotation: keeps old keys, appends new one
                } else {
                    history = [newEntry]; // Standard save: overwrites everything
                }

                localStorage.setItem(this.storageKey, JSON.stringify(history));
                alert(isRotation ? "Sleutels geroteerd en toegevoegd aan geschiedenis!" : "Sleutels overschreven en opgeslagen!");
            },

            loadLatestKeys: function() {
                const history = JSON.parse(localStorage.getItem(this.storageKey) || "[]");
                if (history.length === 0) {
                    alert("Geen sleutels gevonden in de lokale opslag.");
                    return;
                }

                // Gets the most recently added key
                const latest = history[history.length - 1];

                console.log("=== GELADEN SLEUTELS UIT LOCAL STORAGE ===");
                console.log(latest);
                alert(`Sleutels geladen! Kijk in de browser console (F12) om de waarden te zien. Er zitten ${history.length} versies in je opslag.`);
            },

            clearVault: function() {
                if(confirm("Weet je zeker dat je alle lokaal opgeslagen sleutels wilt wissen? Dit kan niet ongedaan worden gemaakt.")) {
                    localStorage.removeItem(this.storageKey);
                    alert("Lokale opslag is gewist.");
                }
            },

            exportVault: function() {
                const data = localStorage.getItem(this.storageKey);
                if (!data || data === "[]") {
                    alert("De opslag is leeg, niets om te exporteren.");
                    return;
                }

                // Creates a downloadable JSON file from the local storage string
                const blob = new Blob([data], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'CryptoTool_Keys_Backup.json';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            },

            importVault: function() {
                const fileInput = document.getElementById('importFile');
                if (!fileInput.files.length) {
                    alert("Kies eerst een .json bestand om te importeren.");
                    return;
                }

                const file = fileInput.files[0];
                const reader = new FileReader();

                // Reads the file asynchronously without blocking the UI
                reader.onload = function(e) {
                    try {
                        JSON.parse(e.target.result); // Validates if the file is actually JSON
                        localStorage.setItem(keyManager.storageKey, e.target.result);
                        alert("Sleutelkluis succesvol geïmporteerd!");
                        fileInput.value = ""; // Resets the file input
                    } catch (err) {
                        alert("Fout: Het geïmporteerde bestand is geen geldige JSON.");
                    }
                };
                reader.readAsText(file);
            }
        };
    </script>
}