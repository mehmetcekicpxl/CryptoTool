@using Encryptie_H4.Models.Hashing
@using System.Security.Authentication
@model FileHashingModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    
}

<head>
    <script src="~/js/CopyFromTextArea.js" defer></script>
</head>



<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h2 class="h5 mb-0">Generate File Hash</h2>
                </div>
                <div class="card-body">
                    <form asp-action="FileHashing" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="fileToHash" class="form-label fw-bold">Select File</label>
                            <input required type="file" asp-for="fileToHash" class="form-control border-primary">
                        </div>
                        <div class="mb-3">
                            <label required asp-for="HashingType" class="form-label fw-bold">Algorithm</label>
                            <select required asp-for="HashingType" class="form-select">
                                <option value="@HashAlgorithmType.Md5">MD5 (Legacy/Learning)</option>
                                <option value="@HashAlgorithmType.Sha1">SHA1 (Weak)</option>
                                <option value="@HashAlgorithmType.Sha256">SHA256 (Recommended)</option>
                                <option value="@HashAlgorithmType.Sha384">SHA384</option>
                                <option value="@HashAlgorithmType.Sha512">SHA512</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 shadow-sm">Generate Hash</button>
                    </form>

                    @if (ViewBag.hex != null)
                    {
                        <div class="mt-4 p-3 bg-light border border-primary rounded">
                            <label class="form-label fw-bold text-primary small">File Hash (Hex):</label>
                            <textarea id="hashResult" class="form-control font-monospace text-break" rows="3" readonly style="font-size: 0.85rem;">@ViewBag.hex</textarea>
                            <button onclick="CopyToClipboard('hashResult')">Copy to clipboard</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h2 class="h5 mb-0">Verify File Integrity</h2>
                </div>
                <div class="card-body">
                    <form asp-action="VerifyFileHex" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Hex" class="form-label fw-bold">Expected Hash</label>
                            <textarea required asp-for="Hex" class="form-control border-info" rows="2" placeholder="Paste hex hash here"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="fileToHash" class="form-label fw-bold">Upload File</label>
                            <input required type="file" asp-for="fileToHash" class="form-control border-info">
                        </div>
                        <div class="mb-3">
                            <label asp-for="HashingType" class="form-label fw-bold">Algorithm</label>
                            <select required asp-for="HashingType" class="form-select">
                                <option value="@HashAlgorithmType.Md5">MD5</option>
                                <option value="@HashAlgorithmType.Sha1">SHA1</option>
                                <option value="@HashAlgorithmType.Sha256">SHA256</option>
                                <option value="@HashAlgorithmType.Sha384">SHA384</option>
                                <option value="@HashAlgorithmType.Sha512">SHA512</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-info text-white w-100 shadow-sm">Verify File</button>
                    </form>

                    @if (ViewBag.Status != null)
                    {
                        <div class="mt-3 alert @(ViewBag.Status.ToString().Contains("Hash klopt!") ? "alert-success border-success" : "alert-danger border-danger") shadow-sm">
                            <h6 class="alert-heading mb-0 font-weight-bold">@ViewBag.Status</h6>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div asp-validation-summary="All" class="mt-4 alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
</div>

