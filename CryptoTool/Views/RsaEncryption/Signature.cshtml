@using Encryptie_H4.Models.RsaEncryption
@model SignatureAndMessage

<head>
    <script src="~/js/CopyFromTextArea.js" defer></script>
</head>


<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="h5 mb-0">Ondertekenen</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Signature" method="post">
                        <div class="mb-3">
                            <label asp-for="Message" class="form-label fw-bold">Bericht</label>
                            <textarea required asp-for="Message" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="RsaPrivateKey" class="form-label fw-bold">Privé Sleutel</label>
                            <textarea required asp-for="RsaPrivateKey" class="form-control font-monospace" rows="4"></textarea>
                        </div>

                        @Html.Hidden("Signature", "(Signature here)")
                        @Html.Hidden("RsaPublicKey", "NA")
                        @Html.Hidden("IsValid", false)

                        <button type="submit" class="btn btn-primary w-100 shadow-sm">Signeer Bericht</button>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.Signature) && Model.Signature != "(Signature here)")
                    {
                        <div class="mt-4 p-3 bg-light border rounded">
                            <label class="form-label fw-bold text-primary small">Digitale Handtekening:</label>
                            <textarea id="TextAreaSignature" class="form-control font-monospace mb-2 text-break" rows="3" readonly>@Model.Signature</textarea>
                            <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="CopyToClipboard('TextAreaSignature')">Kopieer</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-header bg-info text-white text-center">
                    <h2 class="h5 mb-0">Verifiëren</h2>
                </div>
                <div class="card-body">
                    <form asp-action="VerifySignature" method="post">
                        <div class="mb-3">
                            <label asp-for="Message" class="form-label fw-bold">Origineel Bericht</label>
                            <textarea required asp-for="Message" class="form-control border-info" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="RsaPublicKey" class="form-label fw-bold">Publieke Sleutel</label>
                            <textarea required asp-for="RsaPublicKey" class="form-control border-info font-monospace" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Signature" class="form-label fw-bold">Handtekening</label>
                            <textarea required asp-for="Signature" class="form-control border-info font-monospace" rows="2"></textarea>
                        </div>

                        @Html.Hidden("IsValid", false)
                        @Html.Hidden("RsaPrivateKey", "‎‎ ")

                        <button type="submit" class="btn btn-info text-white w-100 shadow-sm">Check Handtekening</button>
                    </form>

                    <div class="mt-3">
                        @if (Model.IsValid)
                        {
                            <div class="alert alert-success d-flex align-items-center mb-0 shadow-sm">
                                <strong>Geldig!</strong> De handtekening is geverifieerd.
                            </div>
                        }
                        else if (ViewBag.Fail != null)
                        {
                            <div class="alert alert-danger mb-0 shadow-sm">
                                <strong>Ongeldig:</strong> @ViewBag.Fail
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div asp-validation-summary="All" class="mt-4 alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
</div>

