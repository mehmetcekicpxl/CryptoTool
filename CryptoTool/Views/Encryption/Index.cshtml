@{
    ViewData["Title"] = "Encryption Tool";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">🔐 Encryptie & Decryptie Tool</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <ul class="nav nav-tabs mb-4" id="cryptoTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="text-tab" data-bs-toggle="tab" data-bs-target="#text-content" type="button" role="tab">
                📝 Tekst Encryptie
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="file-tab" data-bs-toggle="tab" data-bs-target="#file-content" type="button" role="tab">
                📁 Bestand (File) Encryptie
            </button>
        </li>
    </ul>

    <div class="tab-content" id="cryptoTabsContent">
        
        <div class="tab-pane fade show active" id="text-content" role="tabpanel">
            <div class="row">
                <div class="col-md-6">
                    <div class="card shadow-sm border-primary">
                        <div class="card-header bg-primary text-white">Encrypt Tekst</div>
                        <div class="card-body">
                            <form asp-action="Encrypt" method="post">
                                <textarea name="plainText" class="form-control mb-2" rows="3" placeholder="Tekst invoeren..." required>@ViewBag.PlainText</textarea>
                                
                                <div class="row mb-2">
                                    <div class="col"><select name="mode" class="form-select"><option value="CBC">CBC</option><option value="ECB">ECB</option></select></div>
                                    <div class="col"><select name="padding" class="form-select"><option value="PKCS7">PKCS7</option><option value="Zeros">Zeros</option></select></div>
                                </div>

                                <input type="text" name="key" class="form-control mb-2 font-monospace" placeholder="Key (Base64)" value="@ViewBag.Key" required />
                                <input type="text" name="iv" class="form-control mb-3 font-monospace" placeholder="IV (Base64)" value="@ViewBag.IV" required />
                                <button type="submit" class="btn btn-primary w-100">🔒 Encrypt</button>
                            </form>
                            @if (ViewBag.Result != null) { <code class="d-block mt-3 text-break alert alert-success">@ViewBag.Result</code> }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-success">
                        <div class="card-header bg-success text-white">Decrypt Tekst</div>
                        <div class="card-body">
                            <form asp-action="Decrypt" method="post">
                                <textarea name="cipherText" class="form-control mb-2" rows="3" placeholder="Ciphertext..." required>@ViewBag.CipherTextInput</textarea>
                                
                                <div class="row mb-2">
                                    <div class="col"><select name="mode" class="form-select"><option value="CBC">CBC</option><option value="ECB">ECB</option></select></div>
                                    <div class="col"><select name="padding" class="form-select"><option value="PKCS7">PKCS7</option><option value="Zeros">Zeros</option></select></div>
                                </div>

                                <input type="text" name="key" class="form-control mb-2 font-monospace" value="@ViewBag.KeyDecrypt" required />
                                <input type="text" name="iv" class="form-control mb-3 font-monospace" value="@ViewBag.IVDecrypt" required />
                                <button type="submit" class="btn btn-success w-100">🔓 Decrypt</button>
                            </form>
                            @if (ViewBag.DecryptedResult != null) { <div class="alert alert-info mt-3 fw-bold">@ViewBag.DecryptedResult</div> }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="file-content" role="tabpanel">
            <div class="alert alert-warning">
                <i class="bi bi-info-circle"></i> <strong>Let op:</strong> Bestanden worden in het geheugen verwerkt. Upload geen bestanden groter dan 10MB.
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card shadow-sm border-primary">
                        <div class="card-header bg-primary text-white">Encrypt Bestand</div>
                        <div class="card-body">
                            <form asp-action="EncryptFile" method="post" enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label class="form-label">Kies bestand:</label>
                                    <input type="file" name="file" class="form-control" required />
                                </div>

                                <div class="row mb-2">
                                    <div class="col"><select name="mode" class="form-select"><option value="CBC">CBC</option><option value="ECB">ECB</option></select></div>
                                    <div class="col"><select name="padding" class="form-select"><option value="PKCS7">PKCS7</option><option value="Zeros">Zeros</option></select></div>
                                </div>

                                <input type="text" name="key" class="form-control mb-2 font-monospace" placeholder="Plak Key hier..." required />
                                <input type="text" name="iv" class="form-control mb-3 font-monospace" placeholder="Plak IV hier..." required />
                                
                                <button type="submit" class="btn btn-primary w-100">⬇️ Encrypt & Download</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-success">
                        <div class="card-header bg-success text-white">Decrypt Bestand</div>
                        <div class="card-body">
                            <form asp-action="DecryptFile" method="post" enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label class="form-label">Kies versleuteld bestand (.enc):</label>
                                    <input type="file" name="file" class="form-control" required />
                                </div>

                                <div class="row mb-2">
                                    <div class="col"><select name="mode" class="form-select"><option value="CBC">CBC</option><option value="ECB">ECB</option></select></div>
                                    <div class="col"><select name="padding" class="form-select"><option value="PKCS7">PKCS7</option><option value="Zeros">Zeros</option></select></div>
                                </div>

                                <input type="text" name="key" class="form-control mb-2 font-monospace" placeholder="Plak Key hier..." required />
                                <input type="text" name="iv" class="form-control mb-3 font-monospace" placeholder="Plak IV hier..." required />
                                
                                <button type="submit" class="btn btn-success w-100">⬇️ Decrypt & Download</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
