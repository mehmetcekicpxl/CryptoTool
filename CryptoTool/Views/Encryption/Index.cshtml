@{
    ViewData["Title"] = "AES Encryption";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">AES Encryption & Decryption Tool</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-lock-fill"></i> Encrypt (Versleutelen)</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Encrypt" method="post">
                        <div class="mb-2">
                            <label class="form-label">Bericht (Plain Text):</label>
                            <textarea name="plainText" class="form-control" rows="3" required>@ViewBag.PlainText</textarea>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-2">
                                <label class="form-label">Mode:</label>
                                <select name="mode" class="form-select">
                                    <option value="CBC" selected>CBC (Aanbevolen)</option>
                                    <option value="ECB">ECB (Onveilig)</option>
                                </select>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label">Padding:</label>
                                <select name="padding" class="form-select">
                                    <option value="PKCS7" selected>PKCS7</option>
                                    <option value="Zeros">Zeros</option>
                                    <option value="None">None</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Key (Base64):</label>
                            <input type="text" name="key" class="form-control font-monospace" value="@ViewBag.Key" placeholder="Plak hier je Key..." required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">IV (Base64):</label>
                            <input type="text" name="iv" class="form-control font-monospace" value="@ViewBag.IV" placeholder="Plak hier je IV..." required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">🔒 Encrypt Data</button>
                    </form>

                    @if (ViewBag.Result != null)
                    {
                        <div class="alert alert-success mt-3">
                            <strong>Resultaat (Ciphertext):</strong>
                            <code class="d-block text-break mt-1">@ViewBag.Result</code>
                        </div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-success h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-unlock-fill"></i> Decrypt (Ontsleutelen)</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Decrypt" method="post">
                        <div class="mb-2">
                            <label class="form-label">Versleutelde Data (Ciphertext):</label>
                            <textarea name="cipherText" class="form-control" rows="3" required>@ViewBag.CipherTextInput</textarea>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-2">
                                <label class="form-label">Mode:</label>
                                <select name="mode" class="form-select">
                                    <option value="CBC" selected>CBC</option>
                                    <option value="ECB">ECB</option>
                                </select>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label">Padding:</label>
                                <select name="padding" class="form-select">
                                    <option value="PKCS7" selected>PKCS7</option>
                                    <option value="Zeros">Zeros</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Key (Base64):</label>
                            <input type="text" name="key" class="form-control font-monospace" value="@ViewBag.KeyDecrypt" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">IV (Base64):</label>
                            <input type="text" name="iv" class="form-control font-monospace" value="@ViewBag.IVDecrypt" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100">🔓 Decrypt Data</button>
                    </form>

                    @if (ViewBag.DecryptedResult != null)
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Origineel Bericht:</strong>
                            <p class="mb-0 fw-bold">@ViewBag.DecryptedResult</p>
                        </div>
                    }
                    @if (ViewBag.DecryptError != null)
                    {
                        <div class="alert alert-danger mt-3">@ViewBag.DecryptError</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>







