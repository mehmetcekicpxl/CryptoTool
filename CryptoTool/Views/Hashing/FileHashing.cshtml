@using Encryptie_H4.Models.Hashing
@using System.Security.Authentication
@model FileHashingModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 text-secondary"><i class="bi bi-file-earmark-binary text-primary me-2"></i>File Hashing</h1>
    </div>

    <div class="alert alert-warning d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-3"></i>
        <div>
            <strong>Security Notice:</strong> MD5 en SHA1 zijn <span class="badge bg-danger">Deprecated</span>. Gebruik SHA256 of hoger om de integriteit van bestanden veilig te waarborgen.
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Generate File Hash</h2>
                    <button type="button" class="btn btn-sm btn-light py-0" onclick="document.getElementById('formFileHash').reset();">Clear</button>
                </div>
                <div class="card-body">
                    <form asp-action="FileHashing" method="post" enctype="multipart/form-data" id="formFileHash">
                        <div class="mb-3">
                            <label asp-for="fileToHash" class="form-label fw-bold">
                                Select File <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" title="Het bestand wordt niet op de server opgeslagen, alleen lokaal verwerkt."></i>
                            </label>
                            <input required type="file" asp-for="fileToHash" class="form-control border-primary">
                        </div>
                        <div class="mb-4">
                            <label required asp-for="HashingType" class="form-label fw-bold">Algorithm</label>
                            <select required asp-for="HashingType" class="form-select">
                                <option value="@HashAlgorithmType.Md5">MD5 (Legacy/Learning)</option>
                                <option value="@HashAlgorithmType.Sha1">SHA1 (Weak)</option>
                                <option value="@HashAlgorithmType.Sha256" selected>SHA256 (Recommended)</option>
                                <option value="@HashAlgorithmType.Sha384">SHA384</option>
                                <option value="@HashAlgorithmType.Sha512">SHA512</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 shadow-sm btn-loading">
                            <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                            Generate Hash
                        </button>
                    </form>

                    @if (ViewBag.hex != null)
                    {
                        <div class="mt-4 p-3 bg-light border border-primary rounded">
                            <label class="form-label fw-bold text-primary small">File Hash (Hex):</label>
                            <textarea id="hashResult" class="form-control font-monospace text-break mb-2" rows="3" readonly style="font-size: 0.85rem;">@ViewBag.hex</textarea>
                            <button class="btn btn-sm btn-outline-primary w-100" onclick="copyAndDeselect('hashResult')"><i class="bi bi-clipboard"></i> Copy to clipboard</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Verify File Integrity</h2>
                    <button type="button" class="btn btn-sm btn-light py-0" onclick="document.getElementById('formVerifyFile').reset();">Clear</button>
                </div>
                <div class="card-body">
                    <form asp-action="VerifyFileHex" method="post" enctype="multipart/form-data" id="formVerifyFile">
                        <div class="mb-3">
                            <label asp-for="Hex" class="form-label fw-bold">Expected Hash</label>
                            <textarea required asp-for="Hex" class="form-control border-info font-monospace" rows="2" placeholder="Paste hex hash here"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="fileToHash" class="form-label fw-bold">Upload File</label>
                            <input required type="file" asp-for="fileToHash" class="form-control border-info">
                        </div>
                        <div class="mb-4">
                            <label asp-for="HashingType" class="form-label fw-bold">Algorithm</label>
                            <select required asp-for="HashingType" class="form-select">
                                <option value="@HashAlgorithmType.Md5">MD5</option>
                                <option value="@HashAlgorithmType.Sha1">SHA1</option>
                                <option value="@HashAlgorithmType.Sha256" selected>SHA256</option>
                                <option value="@HashAlgorithmType.Sha384">SHA384</option>
                                <option value="@HashAlgorithmType.Sha512">SHA512</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-info text-white w-100 shadow-sm btn-loading">
                            <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                            Verify File
                        </button>
                    </form>

                    @if (ViewBag.Status != null)
                    {
                        <div class="mt-4 p-3 alert @(ViewBag.Status.ToString().Contains("Hash klopt!") ? "alert-success border-success" : "alert-danger border-danger") shadow-sm">
                            <i class="bi @(ViewBag.Status.ToString().Contains("Hash klopt!") ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
                            <strong>@ViewBag.Status</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div asp-validation-summary="All" class="mt-4 alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
</div>

@section Scripts {
    <script src="~/js/CopyFromTextArea.js"></script>
    <script>
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function(e) {
                if(this.checkValidity()) {
                    let btn = this.querySelector('.btn-loading');
                    if(btn) {
                        btn.querySelector('.spinner-border').classList.remove('d-none');
                        btn.disabled = true;
                    }
                }
            });
        });
    </script>
}