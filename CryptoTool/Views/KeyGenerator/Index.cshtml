@{
    ViewData["Title"] = "Key Generator";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-key-fill text-warning me-2"></i>Cryptographic Key Generator</h2>
            <p class="text-muted mb-0">Genereer veilige sleutels voor AES en RSA encryptie.</p>
        </div>
        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#keyInfoModal">
            <i class="bi bi-book"></i> Over Key Sizes
        </button>
    </div>

    <div class="card mb-5 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-shield-lock-fill me-2"></i>AES Sleutel Generatie (Symmetrisch)</h5>
        </div>
        <div class="card-body">
            <p class="card-text text-muted">Gebruik dit voor snelle encryptie van data en bestanden.</p>

            <form asp-action="GenerateAes" method="post" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Sleutelgrootte <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" title="Hoe groter de sleutel, hoe moeilijker te kraken. 256-bit is de militaire standaard."></i></label>
                </div>
                <div class="col-auto">
                    <select name="keySize" class="form-select">
                        <option value="128">128 bits</option>
                        <option value="192">192 bits</option>
                        <option value="256" selected>256 bits (Aanbevolen)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-loading">
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                        Genereer Nieuwe Sleutel
                    </button>
                </div>
            </form>

            @if (ViewBag.AesKeyBase64 != null)
            {
                <div class="alert alert-light border border-success mt-4">
                    <h6 class="alert-heading text-success"><i class="bi bi-check-circle-fill me-1"></i>Sleutel Succesvol Gegenereerd!</h6>
                    <hr>
                    <div class="mb-3">
                        <label class="fw-bold text-secondary">Key (Base64):</label>
                        <input type="text" class="form-control font-monospace" value="@ViewBag.AesKeyBase64" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold text-secondary">IV (Base64):</label>
                        <input type="text" class="form-control font-monospace" value="@ViewBag.AesIVBase64" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold text-secondary">Key (Hex):</label>
                        <input type="text" class="form-control font-monospace text-muted" value="@ViewBag.AesKeyHex" readonly>
                    </div>
                    <form asp-action="DownloadAesKey" method="post" class="mt-3">
                        <input type="hidden" name="keyBase64" value="@ViewBag.AesKeyBase64" />
                        <input type="hidden" name="ivBase64" value="@ViewBag.AesIVBase64" />
                        <button type="submit" class="btn btn-success"><i class="bi bi-download me-1"></i> Download Key & IV (.txt)</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-warning">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-key me-2"></i>RSA Sleutelpaar Generatie (Asymmetrisch)</h5>
        </div>
        <div class="card-body">
            <p class="card-text text-muted">Gebruik dit voor het veilig uitwisselen van sleutels of digitale handtekeningen.</p>

            <form asp-action="GenerateRsa" method="post" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Sleutelgrootte <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" title="RSA sleutels moeten veel groter zijn dan AES sleutels voor dezelfde veiligheid."></i></label>
                </div>
                <div class="col-auto">
                    <select name="keySize" class="form-select">
                        <option value="1024">1024 bits (Onveilig)</option>
                        <option value="2048" selected>2048 bits (Standaard)</option>
                        <option value="4096">4096 bits (Hoogste Veiligheid)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark btn-loading">
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                        Genereer RSA Paar
                    </button>
                </div>
            </form>

            @if (ViewBag.RsaPublicKey != null)
            {
                <div class="mt-4 alert alert-light border border-warning">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="fw-bold text-success mb-2">Public Key (Om te delen):</label>
                            <textarea class="form-control font-monospace mb-2" rows="6" readonly style="font-size: 0.8rem;">@ViewBag.RsaPublicKey</textarea>
                            <form asp-action="DownloadRsaPublicKey" method="post">
                                <input type="hidden" name="publicKey" value="@ViewBag.RsaPublicKey" />
                                <button type="submit" class="btn btn-outline-success btn-sm w-100"><i class="bi bi-download"></i> Download Public Key (.pem)</button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold text-danger mb-2">Private Key (GEHEIM HOUDEN!):</label>
                            <textarea class="form-control font-monospace mb-2" rows="6" readonly style="font-size: 0.8rem;">@ViewBag.RsaPrivateKey</textarea>
                            <form asp-action="DownloadRsaPrivateKey" method="post">
                                <input type="hidden" name="privateKey" value="@ViewBag.RsaPrivateKey" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-download"></i> Download Private Key (.pem)</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="keyInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-book text-info me-2"></i>Over Sleutelgroottes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>De grootte van een sleutel bepaalt hoe moeilijk het is om deze via 'brute force' te raden.</p>
                <ul>
                    <li><strong>AES (Symmetrisch):</strong> Een sleutel van 256 bits wordt beschouwd als onbreekbaar met de huidige technologie en wordt gebruikt door overheden.</li>
                    <li><strong>RSA (Asymmetrisch):</strong> Omdat RSA op wiskundige eigenschappen leunt, moeten de sleutels veel groter zijn. 2048 bits is het minimum voor modern gebruik.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function(e) {
                if(this.checkValidity()) {
                    let btn = this.querySelector('.btn-loading');
                    if(btn) {
                        btn.querySelector('.spinner-border').classList.remove('d-none');
                        btn.disabled = true;
                    }
                }
            });
        });
    </script>
}