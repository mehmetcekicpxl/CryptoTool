@using Encryptie_H4.Models.Hashing
@using System.Security.Authentication
@using static Encryptie_H4.Services.HashingService
@model HmacModel

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="h5 mb-0"><i class="bi bi-key-fill me-2"></i>HMAC Key Generator</h2>
                </div>
                <div class="card-body text-center p-4">
                    <p class="text-muted mb-4">Genereer een cryptografisch veilige sleutel voor HMAC hashing.</p>

                    <a asp-action="HmacGenerateKey" class="btn btn-primary px-4 mb-4 shadow-sm">
                        <i class="bi bi-gear-fill me-2"></i>Generate New Key
                    </a>

                    @if (ViewBag.key != null)
                    {
                        <div class="p-3 bg-light border border-primary rounded text-start shadow-sm">
                            <label class="form-label fw-bold text-primary small">Your Secret Key:</label>
                            <textarea id="keyOutput" class="form-control font-monospace mb-3" rows="3" readonly>@ViewBag.key</textarea>
                            <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="copyAndDeselect('keyOutput')">
                                <i class="bi bi-clipboard"></i> Kopieer naar klembord
                            </button>
                            <div class="alert alert-danger mt-3 mb-0 py-2">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Hou deze key strikt geheim!
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/CopyFromTextArea.js"></script>
}